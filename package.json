{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:pages": "vite build",
    "build:next": "next build",
    "build:all": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && next build",
    "start": "node dist/server.cjs",
    "start:next": "next start",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "preview": "vite preview",
    "clean": "rm -rf dist .next server.js",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && npx -p firebase-tools firebase deploy --only hosting",
    "deploy:ci": "npx -p firebase-tools firebase deploy --only hosting"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
