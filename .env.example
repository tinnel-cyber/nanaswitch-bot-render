# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Micro-Service Paiement Render avec IP Statique Fixie & Webhooks
VITE_PAYMENT_API_URL="https://nana-payment-api.onrender.com"

# Backend AWS Lambda Officiel (Replicate & HLS centralisé côté AWS Lambda)
AWS_LAMBDA_URL="https://lvl7sz2hihrrp6jdui35hm7qnq0zxbkl.lambda-url.eu-north-1.on.aws/"
VITE_AWS_LAMBDA_URL="https://lvl7sz2hihrrp6jdui35hm7qnq0zxbkl.lambda-url.eu-north-1.on.aws/"

# ImgBB API (Hébergement d'images gratuit en direct)
VITE_IMGBB_API_KEY="your_imgbb_api_key_here"
IMGBB_API_KEY="your_imgbb_api_key_here"

# Brevo (Sendinblue) Emailing & SMTP Relais Transactionnel (Garder les clés bien sécurisées)
BREVO_API_KEY="xkeysib-votre-cle-api-ici"
BREVO_SENDER_EMAIL="contact@votre-domaine.com"
BREVO_SENDER_NAME="NomDeVotreApp"
BREVO_SMTP_KEY="your_brevo_smtp_key_here"

# Firebase Admin SDK (pour les opérations serveur sécurisées)
# Téléchargez le fichier JSON depuis la console Firebase: Project Settings > Service Accounts > Generate New Private Key
# Le contenu du fichier JSON doit être converti en variables d'environnement ci-dessous
FIREBASE_TYPE="service_account"
FIREBASE_PROJECT_ID="nanasore"
FIREBASE_PRIVATE_KEY_ID="your_private_key_id_here"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@nanasore.iam.gserviceaccount.com"
FIREBASE_CLIENT_ID="your_client_id_here"
FIREBASE_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
FIREBASE_TOKEN_URI="https://oauth2.googleapis.com/token"
FIREBASE_AUTH_PROVIDER_X509_CERT_URL="https://www.googleapis.com/oauth2/v1/certs"
FIREBASE_CLIENT_X509_CERT_URL="https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40nanasore.iam.gserviceaccount.com"


