# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Micro-Service Paiement Render avec IP Statique Fixie & Webhooks
VITE_PAYMENT_API_URL="https://nana-payment-api.onrender.com"

# Backend AWS Lambda Officiel (Replicate & HLS centralisé côté AWS Lambda)
AWS_LAMBDA_URL="https://lvl7sz2hihrrp6jdui35hm7qnq0zxbkl.lambda-url.eu-north-1.on.aws/"
VITE_AWS_LAMBDA_URL="https://lvl7sz2hihrrp6jdui35hm7qnq0zxbkl.lambda-url.eu-north-1.on.aws/"

# ImgBB API (Hébergement d'images gratuit en direct)
VITE_IMGBB_API_KEY="your_imgbb_api_key_here"
IMGBB_API_KEY="your_imgbb_api_key_here"

# Brevo (Sendinblue) Emailing & SMTP Relais Transactionnel (Garder les clés bien sécurisées)
BREVO_API_KEY="xkeysib-votre-cle-api-ici"
BREVO_SENDER_EMAIL="contact@votre-domaine.com"
BREVO_SENDER_NAME="NomDeVotreApp"
BREVO_SMTP_KEY="your_brevo_smtp_key_here"

# Supabase Configuration
VITE_SUPABASE_URL="https://wsxnznobeefrsoicjqte.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Configuration Daily.co WebRTC (Salons Wameet & Live Streaming)
# La clé DAILY_API_KEY doit être définie dans l'environnement du serveur Render, jamais committée sur GitHub
DAILY_API_KEY=
DAILY_DOMAIN=nanasore
VITE_DAILY_DOMAIN=nanasore



