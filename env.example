# Configuration Exemple des Variables d'Environnement
# Attention : Ne commitez JAMAIS vos clés secrètes réelles dans git. Gardez vos clés sécurisées.

# Gemini API
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL
APP_URL="http://localhost:3000"

# Brevo (Sendinblue) Emailing Transactionnel API v3
BREVO_API_KEY=xkeysib-votre-cle-api-ici
BREVO_SENDER_EMAIL=contact@votre-domaine.com
BREVO_SENDER_NAME=NomDeVotreApp

# Micro-Service Paiement Render
VITE_PAYMENT_API_URL="https://nana-payment-api.onrender.com"

# AWS Lambda
AWS_LAMBDA_URL="https://your-lambda-url.on.aws/"
VITE_AWS_LAMBDA_URL="https://your-lambda-url.on.aws/"

# ImgBB API
IMGBB_API_KEY="your_imgbb_api_key_here"
VITE_IMGBB_API_KEY="your_imgbb_api_key_here"
